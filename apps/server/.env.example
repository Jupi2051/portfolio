# Database connection string
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# JWT secret key for authentication tokens
JWT_SECRET="your-secret-key-here-change-in-production"

# Instatus API configuration
INSTATUS_API_KEY="your-instatus-api-key"
INSTATUS_COMPONENT="your-instatus-component-id"

# Local directory for exported Vico sketch WebP files
IMAGES_BUCKET="/data/vico-images"

# Discord bot token used by the Rivals Randomizer to look up player profiles
DISCORD_BOT_TOKEN="your-discord-bot-token"

# Server configuration
PORT=3000
NODE_ENV="development"

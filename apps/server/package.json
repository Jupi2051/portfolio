{
  "name": "@portfolio/server",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm prisma generate && pnpm tsc -p tsconfig.types.json && tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js",
    "start": "tsx dist/src/index.js",
    "start:prod": "node dist/src/index.js",
    "build:types": "pnpm prisma generate && pnpm tsc -p tsconfig.types.json"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@portfolio/shared": "workspace:*",
    "@portfolio/types": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@trpc/server": "^11.18.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-vibrant": "^4.0.4",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
